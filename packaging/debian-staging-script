#!/bin/bash

# MotionStudio Debian Package Staging Directory Generator
# Usage: ./debian-staging-script [version] [architecture]

set -e

APP_NAME="motionstd"
DISPLAY_NAME="MotionStudio"
VERSION="${1:-0.1.0}"
ARCHITECTURE="${2:-amd64}"
MAINTAINER="Zahid Khalilov <halilzahid@gmail.com>"
GITHUB_URL="https://github.com/zahid4kh"
DESCRIPTION="3D physics simulation studio for mechanical engineers"
STARTUP_WM_CLASS="MotionStudio"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STAGING_DIR="$SCRIPT_DIR/staging_${APP_NAME}"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${BLUE}Creating Debian staging directory for ${DISPLAY_NAME} (${APP_NAME})${NC}"
echo -e "${BLUE}Version: ${VERSION}  Architecture: ${ARCHITECTURE}${NC}"

if [ -d "$STAGING_DIR" ]; then
    echo -e "${YELLOW}Removing existing staging directory...${NC}"
    rm -rf "$STAGING_DIR"
fi

mkdir -p "$STAGING_DIR"/{DEBIAN,usr/{bin,lib/$APP_NAME,share/{applications,pixmaps,doc/$APP_NAME}},etc/$APP_NAME}

cd "$STAGING_DIR"

cat > DEBIAN/control << EOF
Package: $APP_NAME
Version: $VERSION
Section: science
Priority: optional
Architecture: $ARCHITECTURE
Depends: libqt6core6t64, libqt6gui6t64, libqt6widgets6t64, libqt6opengl6t64, libqt6openglwidgets6t64, libgl1, libegl1, libxkbcommon0, libglib2.0-0t64
Maintainer: $MAINTAINER
Homepage: $GITHUB_URL
Description: $DESCRIPTION
 MotionStudio is a desktop application for building 3D mechanical scenes,
 defining joints and motors, and running physics simulations with MuJoCo.
 .
 This package installs the motionstd launcher, application binary, and
 bundled MuJoCo runtime library.
EOF

cat > DEBIAN/postinst << EOF
#!/bin/bash
set -e

case "\$1" in
    configure)
        chmod +x /usr/bin/$APP_NAME
        chmod +x /usr/lib/$APP_NAME/$APP_NAME

        if [ ! -L /usr/local/bin/$APP_NAME ]; then
            ln -sf /usr/bin/$APP_NAME /usr/local/bin/$APP_NAME
        fi

        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications
        fi

        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q /usr/share/pixmaps 2>/dev/null || true
        fi

        if command -v update-mime-database >/dev/null 2>&1; then
            update-mime-database /usr/share/mime 2>/dev/null || true
        fi

        if command -v hash >/dev/null 2>&1; then
            hash -r 2>/dev/null || true
        fi

        echo "$DISPLAY_NAME installed successfully"
        echo "Run from the applications menu or terminal: $APP_NAME"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \\\`\$1'" >&2
        exit 1
        ;;
esac

exit 0
EOF

cat > DEBIAN/preinst << 'EOF'
#!/bin/bash
set -e

case "$1" in
    install|upgrade)
        ;;
    abort-upgrade)
        ;;
    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
EOF

cat > DEBIAN/prerm << EOF
#!/bin/bash
set -e

case "\$1" in
    remove|upgrade|deconfigure)
        pkill -f "/usr/lib/$APP_NAME/$APP_NAME" || true

        if [ -L /usr/local/bin/$APP_NAME ]; then
            rm -f /usr/local/bin/$APP_NAME
        fi

        if command -v hash >/dev/null 2>&1; then
            hash -r 2>/dev/null || true
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \\\`\$1'" >&2
        exit 1
        ;;
esac

exit 0
EOF

cat > DEBIAN/postrm << EOF
#!/bin/bash
set -e

case "\$1" in
    purge)
        rm -rf /etc/$APP_NAME

        if [ -L /usr/local/bin/$APP_NAME ]; then
            rm -f /usr/local/bin/$APP_NAME
        fi

        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications
        fi

        if command -v hash >/dev/null 2>&1; then
            hash -r 2>/dev/null || true
        fi
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \\\`\$1'" >&2
        exit 1
        ;;
esac

exit 0
EOF

chmod 755 DEBIAN/{postinst,preinst,prerm,postrm}

cat > usr/bin/$APP_NAME << EOF
#!/bin/bash

APP_BINARY="/usr/lib/$APP_NAME/$APP_NAME"

if [ ! -f "\$APP_BINARY" ]; then
    echo "Error: Application binary not found at \$APP_BINARY"
    exit 1
fi

export LD_LIBRARY_PATH="/usr/lib/$APP_NAME:\${LD_LIBRARY_PATH:-}"
exec "\$APP_BINARY" "\$@"
EOF

chmod +x usr/bin/$APP_NAME

cat > usr/share/applications/$APP_NAME.desktop << EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$DISPLAY_NAME
GenericName=Physics Simulation Studio
Comment=$DESCRIPTION
Exec=$APP_NAME %F
Icon=$APP_NAME
Terminal=false
StartupNotify=true
StartupWMClass=$STARTUP_WM_CLASS
Categories=Science;Education;Engineering;
Keywords=physics;simulation;robotics;mechanics;mujoco;3d;
MimeType=application/x-motionstudio-project;
EOF

cat > usr/share/doc/$APP_NAME/README << EOF
$DISPLAY_NAME ($APP_NAME) - Version $VERSION
===========================================

$DESCRIPTION

INSTALLATION
------------
    sudo dpkg -i ${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb

USAGE
-----
    $APP_NAME

Or launch "$DISPLAY_NAME" from your desktop applications menu.

PROJECT FILES
-------------
MotionStudio projects use the .mstudio extension.

AUTHOR
------
Zahid Khalilov <halilzahid@gmail.com>
$GITHUB_URL
EOF

cat > usr/share/doc/$APP_NAME/copyright << EOF
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: MotionStudio
Source: $GITHUB_URL

Files: *
Copyright: $(date +%Y) Zahid Khalilov <halilzahid@gmail.com>
License: MIT

License: MIT
